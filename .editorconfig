# Editor settings shared by every contributor. Line endings match .gitattributes,
# and indentation matches the existing files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# A trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
