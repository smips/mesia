# Build output
/build/
/out/
CMakeUserPresets.json
compile_commands.json

# IDEs
/.vs/
/.vscode/
/.idea/
*.user

# Claude Code files (CLAUDE.md, CLAUDE.local.md, .claude/)
CLAUDE*
.claude/

# ROMs and anything derived from them. Never commit these (see the hard
# rules); the character classes match any letter case, since Linux and
# macOS treat case as significant.
*.[nN][eE][sS]
*.[uU][nN][fF]
*.[uU][nN][iI][fF]
*.[fF][dD][sS]
*.[nN][sS][fF]
*.[nN][sS][fF][eE]
*.[pP][rR][gG]
*.[cC][hH][rR]
/roms/
/extracted/

# Battery saves and emulator save states, which hold game RAM
*.[sS][aA][vV]
*.[sS][rR][mM]
*.[mM][sS][sS]

# Python tooling
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
